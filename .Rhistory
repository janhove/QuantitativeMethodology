shapes = c("two_bumps", "two_bumps", "two_bumps", "two_bumps"),
s = rep(0, 3),
margins_lo = lo,
margins_hi = hi)
draw_boxplot(d3, main = "Five modes")
d3 <- boxplot_data(k, minv, q1, q2, q3, maxv,
shapes = c("two_bumps", "two_bumps", "two_bumps", "two_bumps"),
s = c(min(q1 - minv, q2 - q1), min(q2 - q1, q3 - q2), min(q3 - q2, maxv - q3)) / 2,
margins_lo = rep(0.5,4),
margins_hi = rep(0.5,4))
draw_boxplot(d3, main = "Five modes")
